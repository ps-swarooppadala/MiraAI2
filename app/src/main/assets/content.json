      "displayName": "Warrior II",
      "sanskritName": "Virabhadrasana II",
      "thumbnail": "ic_placeholder",
      "instructionSteps": [
        "Step your feet wide apart, front foot forward.",
        "Bend the front knee to roughly 90°, keeping it above the ankle.",
        "Extend your arms parallel to the floor, gaze over the front hand."
      ],
