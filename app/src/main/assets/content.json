      "id": "tree_pose",
      "displayName": "Tree Pose",
      "sanskritName": "Vrksasana",
      "thumbnail": "ic_placeholder",
      "instructionSteps": [
        "Shift your weight onto one foot.",
        "Place the other foot on your inner calf or thigh, avoiding the knee.",
        "Bring your palms together at your chest and find a steady gaze point."
      ],
      "defaultHoldSec": 15,
      "trackingMode": "HOLD",
      "hasAssessorRuleSet": false
    },
    {
      "id": "chair_pose",
      "displayName": "Chair Pose",
      "sanskritName": "Utkatasana",
      "thumbnail": "ic_placeholder",
      "instructionSteps": [
        "Stand with feet hip-width apart.",
        "Bend your knees and sink your hips back, as if sitting into a chair.",
        "Reach your arms overhead and keep your chest lifted."
      ],
      "defaultHoldSec": 20,
      "trackingMode": "HOLD",
      "hasAssessorRuleSet": false
